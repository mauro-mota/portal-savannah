FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DJANGO_SETTINGS_MODULE=config.demo_settings
WORKDIR /app
COPY requirements.lock.txt .
RUN pip install --no-cache-dir -r requirements.lock.txt
RUN useradd --create-home --uid 10001 portal
COPY --chown=portal:portal . .
RUN mkdir -p /app/staticfiles /app/demo-data && chown -R portal:portal /app
USER portal
CMD ["sh", "start-demo.sh"]
